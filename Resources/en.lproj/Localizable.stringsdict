<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>%lld notes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld note</string>
            <key>other</key>
            <string>%lld notes</string>
        </dict>
    </dict>
    <key>%lld folders</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld folder</string>
            <key>other</key>
            <string>%lld folders</string>
        </dict>
    </dict>
    <key>%lld tasks</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld task</string>
            <key>other</key>
            <string>%lld tasks</string>
        </dict>
    </dict>
    <key>%lld words</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld word</string>
            <key>other</key>
            <string>%lld words</string>
        </dict>
    </dict>
    <key>Found %lld recent PDF documents in your local storage:</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Found %lld recent PDF document in your local storage:</string>
            <key>other</key>
            <string>Found %lld recent PDF documents in your local storage:</string>
        </dict>
    </dict>
    <key>Here are the %lld most recent downloaded files from your storage:</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Here is the %lld most recent downloaded file from your storage:</string>
            <key>other</key>
            <string>Here are the %lld most recent downloaded files from your storage:</string>
        </dict>
    </dict>
    <key>Found %lld image assets matching your search:</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Found %lld image asset matching your search:</string>
            <key>other</key>
            <string>Found %lld image assets matching your search:</string>
        </dict>
    </dict>
    <key>Found %lld matching documents in your local storage:</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Found %lld matching document in your local storage:</string>
            <key>other</key>
            <string>Found %lld matching documents in your local storage:</string>
        </dict>
    </dict>
    <key>%lld words, %lld characters</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@words@, %#@chars@</string>
        <key>words</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld word</string>
            <key>other</key>
            <string>%lld words</string>
        </dict>
        <key>chars</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld character</string>
            <key>other</key>
            <string>%lld characters</string>
        </dict>
    </dict>
</dict>
</plist>
